# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...menos o template. O padrão acima é do scaffold do Next e engolia o próprio
# arquivo que o README manda copiar — quem clonasse o repositório não teria por
# onde começar.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Levô
.env
.env*.local
/prisma/*.db
/infra/osrm-data/

# Saída do prisma generate. Não é versionada porque todo caminho de build já a
# recria: o CI via postinstall do `npm ci`, o Dockerfile com `npx prisma
# generate` explícito (ele instala com --ignore-scripts). Versionar só rendia
# 48 mil linhas de ruído no diff a cada mudança de schema ou de versão.
/src/generated/

# Android
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
*.jks
*.keystore
