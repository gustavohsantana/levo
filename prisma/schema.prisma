// Schema do Levô.
//
// Duas decisões que parecem exageradas com um cliente só, e que seriam caras
// demais para retrofitar depois:
//
//  1. `establishmentId` em toda tabela desde o primeiro dia — migrar dado de
//     produção para multi-tenant é a pior tarde de trabalho que existe;
//  2. `@@unique([establishmentId, source, externalId])` em Order — é a garantia
//     de idempotência contra a reentrega de eventos do iFood.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderSourceKind {
  MANUAL
  /// Pedido feito pelo proprio cliente, no cardapio publico.
  SITE
  WEBHOOK
  IFOOD
  AIQFOME
  /// 99Food (DiDi Food). Valor não começa com dígito porque enum do Prisma
  /// exige identificador válido — "99FOOD" seria inválido.
  FOOD99
}

/// Como o pedido chega ao cliente.
enum OrderFulfillment {
  /// O motoboy leva. E o caso que o sistema inteiro assume por padrao.
  DELIVERY
  /// O cliente busca no balcao. Nao entra em rota, nao paga taxa, e o
  /// "entregue" acontece quando ele aparece na loja.
  PICKUP
  /// Quem leva e o entregador da PLATAFORMA (99Food, iFood, aiqfome), nao o
  /// nosso motoboy. Fica fora da rota pelo mesmo motivo da retirada — nao ha
  /// motoboy nosso para despachar —, mas quem aparece no balcao nao e o
  /// cliente, e a cozinha precisa saber disso.
  PLATFORM
}

enum OrderStatus {
  NEW
  IN_ROUTE
  DELIVERED
  FAILED
  // Cancelado na plataforma de origem, não pelo Levô. Estado terminal: o
  // pedido não entra em rota, e sai de qualquer rota em que já esteja.
  CANCELLED
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  FINISHED
}

enum StopStatus {
  PENDING
  DELIVERED
  FAILED
}

model Establishment {
  id                  String   @id @default(uuid())
  name                String
  address             String
  /// Endereco publico do cardapio: /cardapio/{slug}.
  ///
  /// Legivel de proposito — o dono manda esse link no Instagram e no WhatsApp,
  /// e um uuid ali seria um link que ninguem digita nem confia.
  slug                String?  @unique
  /// Cidade e estado da operação.
  ///
  /// Entram em toda busca de endereço: sem eles o geocodificador procura no
  /// pais inteiro e "Rua das Flores, 100" casa com a primeira rua homonima que
  /// aparecer. O dono nao digita a cidade dele em cada pedido — nem deveria.
  city                String?
  state               String?
  /// Taxa de entrega sugerida ao lancar pedido manual. Editavel no pedido.
  deliveryFeeCents    Int      @default(0)
  /// Aceita sozinho o pedido que chega do marketplace.
  ///
  /// O iFood exige confirmacao em ate 3 minutos e penaliza quem passa disso.
  /// Numa cozinha cheia, ninguem olha a tela a cada dois minutos — e o preco
  /// de esquecer nao e um aviso, e ranking pior na plataforma.
  ///
  /// Desligado por padrao porque aceitar e um compromisso: aceito e pedido que
  /// vai sair. Quem liga isto esta dizendo que aceita tudo o que chegar, e essa
  /// decisao e do dono, nao nossa.
  autoConfirmOrders   Boolean  @default(false)
  /// Ordem das categorias no cardapio, pelo nome.
  ///
  /// Categoria e texto livre no produto, entao a ordem nao tem onde morar do
  /// lado dela — mora aqui. Nome que nao estiver nesta lista vai para o fim, em
  /// ordem alfabetica: categoria recem-criada aparece, so nao na frente de quem
  /// ja foi posicionado.
  ///
  /// Sem isto o cardapio sai em ordem alfabetica, e uma pizzaria abre com
  /// "Acai" porque comeca com A. Ordem de cardapio e decisao comercial.
  categoryOrder       String[] @default([])
  /// Pede ao motoboy a localizacao ao vivo pelo Telegram, junto com a rota.
  ///
  /// Desligado por padrao: e o dono decidindo se quer acompanhar a moto no
  /// mapa, e o motoboy ainda decide se compartilha — o bot pode pedir, nunca
  /// ligar sozinho. Rastrear alguem sem que ele saiba nao e um recurso.
  /// Exige o codigo do cliente para o entregador fechar a entrega.
  ///
  /// Desligado por padrao: ligar muda o trabalho do motoboy no meio do turno, e
  /// essa decisao e do dono. O painel continua podendo concluir sem codigo —
  /// telefone descarregado e endereco sem ninguem existem, e travar a operacao
  /// por causa deles seria pior que o problema.
  /// Oferece retirada no balcao no cardapio publico.
  ///
  /// Desligado por padrao: nem toda cozinha tem balcao, e oferecer retirada
  /// onde ninguem pode buscar gera pedido que o dono vai ter que ligar para
  /// desfazer.
  pickupEnabled       Boolean  @default(false)
  requireDeliveryCode Boolean  @default(false)
  telegramLocation    Boolean  @default(false)
  /// Manda a rota para o motoboy no WhatsApp assim que ela e planejada.
  ///
  /// Desligado por padrao, e de proposito: mensagem automatica sai de um numero
  /// que pode ser banido, e ligar isso e uma decisao do dono — nao um padrao que
  /// ele descobre quando o motoboy reclama.
  whatsappRoutes      Boolean  @default(false)
  lat                 Float
  lng                 Float
  createdAt           DateTime @default(now())

  users                 User[]
  couriers              Courier[]
  orders                Order[]
  payments              Payment[]
  routes                Route[]
  events                DomainEventLog[]
  credentials           IntegrationCredential[]
  marketplaceCommands   MarketplaceCommand[]
  products              Product[]
  optionGroups          OptionGroup[]
  deliveryFeeRules      DeliveryFeeRule[]
  courierNotifications  CourierNotification[]
  whatsappChannels      WhatsappChannel[]
  whatsappConversations WhatsappConversation[]
  whatsappSession       WhatsappSession?
}

model User {
  id              String   @id @default(uuid())
  establishmentId String
  email           String   @unique
  name            String
  passwordHash    String
  createdAt       DateTime @default(now())

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
}

/// Como o motoboy e pago. Os tres acordos que o mercado usa de verdade.
/// Quanto o sistema acompanha o motoboy.
enum CourierTracking {
  /// So no momento da entrega: a posicao e capturada quando ele confirma cada
  /// parada. Prova onde ele estava, sem segui-lo o dia inteiro. E o padrao.
  CHECKIN
  /// Posicao continua durante o turno. Exige que ele compartilhe, e sem isso a
  /// rota nao aparece — decisao do dono, motoboy por motoboy.
  CONTINUOUS
}

enum CourierPayModel {
  /// Valor unico por corrida, independente da distancia. O mais comum em
  /// cidade pequena, onde tudo e perto.
  POR_ENTREGA
  /// Faixas de distancia, como a taxa do cliente — mas com outros numeros: se
  /// cobra R$ 12 e se paga R$ 8.
  POR_FAIXA
  /// Diaria garantida mais um valor por corrida. Usado com motoboy fixo, para
  /// ele nao sair no prejuizo em dia fraco.
  DIARIA_E_ENTREGA
  /// Diaria garantida mais o valor por faixa de distancia. Para o motoboy fixo
  /// que ainda ganha mais na corrida longa — a diaria nao dependia da faixa.
  DIARIA_E_FAIXA
}

model Courier {
  id                  String          @id @default(uuid())
  establishmentId     String
  name                String
  phone               String
  active              Boolean         @default(true)
  /// Usuario do app do motoboy. Nulo ate o dono gerar o acesso.
  login               String?         @unique
  passwordHash        String?
  /// O acordo combinado com este motoboy.
  ///
  /// Fica no motoboy, e nao no estabelecimento, porque acordo e pessoal: o
  /// veterano tem faixa e o que entra hoje ganha fixo, na mesma loja.
  payModel            CourierPayModel @default(POR_ENTREGA)
  /// Quanto por corrida. Vale em POR_ENTREGA e em DIARIA_E_ENTREGA.
  payPerDeliveryCents Int             @default(0)
  /// A diaria garantida, contada uma vez por dia em que ele rodou.
  payDailyCents       Int             @default(0)
  /// A conversa dele com o bot do Telegram.
  ///
  /// Nula ate o motoboy tocar no convite: bot do Telegram nao pode iniciar
  /// conversa, e essa e justamente a regra que torna o canal seguro — ninguem
  /// recebe mensagem de quem nao autorizou, e por isso ninguem e banido por
  /// mandar.
  /// Unico: uma conversa do Telegram pertence a um entregador so.
  ///
  /// A unicidade nao e decoracao — ela permite `findUnique`, que e como o
  /// webhook descobre de quem e a posicao sem ja saber o estabelecimento. O
  /// tenant-guard recusa `findFirst` sem escopo, e com razao.
  /// Quanto o sistema acompanha este motoboy. Acordo pessoal, como o pagamento.
  /**
   * /**
   * /**
   * Quantos pedidos ele leva por viagem.
   * Era 15 fixo no código, igual para todo mundo. Quem entrega de carro leva
   * mais, quem entrega de bicicleta leva bem menos — e o baú da marmitaria não
   * comporta o mesmo número de pedidos que o da lanchonete.
   */
  maxStops            Int             @default(15)
  tracking            CourierTracking @default(CHECKIN)
  /// Quando ele recusou a permissao de localizacao no aparelho.
  ///
  /// Guardado para a tela do dono poder dizer POR QUE nao ha rastreio. "Recusou"
  /// e "esta com o aplicativo fechado" sao conversas diferentes: uma e escolha
  /// dele, a outra e circunstancia.
  trackingDeniedAt    DateTime?
  telegramChatId      String?         @unique
  /// Segredo do convite. Vive no link `t.me/bot?start=<isto>` e some no uso.
  telegramInviteCode  String?         @unique
  createdAt           DateTime        @default(now())

  establishment Establishment    @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  routes        Route[]
  payBands      CourierPayBand[]

  @@index([establishmentId, active])
}

/// Faixa de pagamento por distancia, de um motoboy.
model CourierPayBand {
  id          String @id @default(uuid())
  courierId   String
  /// Limite superior da faixa. A ultima cobre tudo acima dela.
  uptoMeters  Int
  amountCents Int

  courier Courier @relation(fields: [courierId], references: [id], onDelete: Cascade)

  @@index([courierId, uptoMeters])
}

model Order {
  id               String           @id @default(uuid())
  establishmentId  String
  source           OrderSourceKind
  externalId       String?
  /// O numero curto do pedido na plataforma de origem — "1366" no iFood.
  ///
  /// E por ele que o cliente liga reclamando e que o suporte do marketplace
  /// identifica o pedido. Sem ele, quatro pedidos no mesmo minuto viram
  /// quatro cartoes indistinguiveis, e o dono nao casa o que ve na tela com o
  /// que a plataforma pergunta.
  displayId        String?
  customerName     String
  customerPhone    String?
  address          String
  reference        String?
  lat              Float?
  lng              Float?
  amountCents      Int              @default(0)
  /// Taxa de entrega, ja somada em `amountCents`. Guardada a parte porque o
  /// acerto do dia separa o que e venda do que e frete.
  deliveryFeeCents Int              @default(0)
  paymentMethod    PaymentMethod?
  /// Nulo = pagar na entrega. `PENDING` = Pix online aguardando pagamento.
  paymentStatus    PaymentStatus?
  notes            String?
  status           OrderStatus      @default(NEW)
  /// Codigo que o cliente informa ao entregador para fechar a entrega.
  ///
  /// Quatro digitos porque e ditado na porta, muitas vezes com a moto ligada.
  /// Nao e seguranca — e prova de presenca: sem ele, "entregue" e a palavra de
  /// uma pessoa so, e o dono descobre a divergencia pelo cliente reclamando.
  /// Entrega ou retirada no balcao.
  ///
  /// Um pedido de retirada nao e um pedido de entrega com endereco da loja: ele
  /// nao entra em rota, nao paga taxa, nao rende ping de motoboy e nao conta no
  /// tempo medio de entrega. Marcar com um campo proprio evita que cada uma
  /// dessas telas precise adivinhar pelo endereco.
  fulfillment      OrderFulfillment @default(DELIVERY)
  deliveryCode     String?
  trackingToken    String           @unique
  routeId          String?
  /// Aceito pelo lojista. Antes disso o pedido esta na coluna "novos", que e
  /// onde ele decide se consegue atender.
  confirmedAt      DateTime?
  /// Saiu da cozinha e espera motoboy. Separa "montando" de "pronto" no
  /// painel, que sao filas com donos diferentes.
  readyAt          DateTime?
  /**
   * Quando o dono marcou este pedido como urgente.
   * Data e não booleano: "há quanto tempo está urgente" é a pergunta que o
   * painel faz, e um `true` não responde. Nulo é o normal.
   */
  urgentAt         DateTime?
  createdAt        DateTime         @default(now())
  deliveredAt      DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  stop          RouteStop?
  items         OrderItem[]
  payment       Payment?

  // ⭐ A idempotência da importação, garantida pelo banco.
  //
  // No Postgres, NULLs são distintos entre si num índice único — então vários
  // pedidos manuais (todos com externalId nulo) convivem sem conflito, e ainda
  // assim o mesmo pedido do iFood nunca entra duas vezes.
  @@unique([establishmentId, source, externalId])
  @@index([establishmentId, status, createdAt])
  @@index([establishmentId, createdAt])
}

model Route {
  id                      String      @id @default(uuid())
  establishmentId         String
  courierId               String
  status                  RouteStatus @default(PLANNED)
  accessToken             String      @unique
  geometry                String?
  distanceMeters          Int         @default(0)
  durationSeconds         Int         @default(0)
  // O "antes" da comparação: a rota na ordem em que os pedidos chegaram.
  baselineDurationSeconds Int         @default(0)
  createdAt               DateTime    @default(now())
  startedAt               DateTime?
  finishedAt              DateTime?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  courier       Courier       @relation(fields: [courierId], references: [id])
  stops         RouteStop[]
  pings         CourierPing[]

  @@index([establishmentId, status, createdAt])
  @@index([courierId, status])
}

model RouteStop {
  id                String     @id @default(uuid())
  routeId           String
  orderId           String     @unique
  position          Int
  status            StopStatus @default(PENDING)
  etaSeconds        Int        @default(0)
  legDistanceMeters Int        @default(0)
  resolvedAt        DateTime?
  failureReason     String?

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([routeId, position])
  @@index([routeId, status])
}

// Posição do motoboy, ~a cada 15s durante a rota.
//
// De longe a tabela mais escrita do sistema: 100 clientes × 5 motoboys × 4
// pings/min é o primeiro gargalo real de escala. Por isso nasce com política de
// retenção (`purgeFinishedBefore`) — que serve à LGPD e à escala com a mesma
// medida.
model CourierPing {
  id         String   @id @default(uuid())
  routeId    String
  lat        Float
  lng        Float
  recordedAt DateTime
  /// De onde veio: APP (a tela do motoboy) ou TELEGRAM (ele compartilhou).
  ///
  /// Para desenhar o mapa da na mesma. Para responder "por que voces tem minha
  /// localizacao?" — pergunta que um entregador pode fazer e que a LGPD da a
  /// ele o direito de fazer — nao da: sao consentimentos diferentes, dados em
  /// momentos diferentes, e sem isto a resposta seria um encolher de ombros.
  source     String   @default("APP")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId, recordedAt])
}

// Log append-only de fatos do domínio.
//
// Um mecanismo, três retornos: métricas do piloto, auditoria e, quando
// escalar, a base para processamento assíncrono (padrão outbox).
model DomainEventLog {
  id              String   @id @default(uuid())
  establishmentId String
  name            String
  aggregateId     String
  payload         Json
  occurredAt      DateTime

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([establishmentId, name, occurredAt])
  @@index([establishmentId, occurredAt])
}

// Cache de geocodificação.
//
// Deliberadamente **sem** establishmentId: a relação endereço → coordenada é
// fato geográfico público, não dado de cliente. Compartilhar entre
// estabelecimentos multiplica a taxa de acerto e é o que mantém o consumo
// dentro da faixa gratuita do provedor.
model GeocodeCache {
  cacheKey  String   @id
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

enum IntegrationProvider {
  IFOOD
  AIQFOME
  /// 99Food (DiDi Food Open Platform). "FOOD99" e não "99FOOD" porque valor de
  /// enum do Prisma precisa ser identificador válido, e identificador não
  /// começa com dígito.
  FOOD99
  /// Recebimento no cardápio público. Não traz pedido para dentro como os
  /// outros dois — traz dinheiro para a conta do lojista.
  MERCADO_PAGO
  /// Cloud API do WhatsApp (Meta). Diferente dos marketplaces: aqui não existe
  /// pedido pronto do outro lado — existe uma conversa, e o pedido nasce dela.
  WHATSAPP
}

// Credencial de integração obtida por OAuth, uma por estabelecimento e provedor.
//
// Existe porque o aiqfome autoriza por *authorization code*: quem consente é o
// lojista, no navegador dele, e o que volta é um token com prazo de validade —
// diferente de uma chave estática, que caberia numa variável de ambiente. Com
// dois estabelecimentos, cada um traz o seu.
//
// Os tokens são gravados **cifrados** (ver `token-cipher`). Um vazamento de
// dump de banco não pode virar acesso à conta do lojista no marketplace.
model IntegrationCredential {
  id              String              @id @default(uuid())
  establishmentId String
  provider        IntegrationProvider
  accessToken     String
  refreshToken    String?
  scope           String?
  // A loja que o lojista autorizou. Vem da própria autorização, não de
  // variável de ambiente: com dois estabelecimentos, cada um tem a sua.
  merchantId      String?
  // Chave publicável do provedor, quando ele tem uma. Fica em claro de
  // propósito: ela é feita para aparecer no navegador, e cifrar o que é público
  // só esconderia do próprio código.
  publicKey       String?
  // Falso quando a autorização foi feita contra o ambiente de testes. Sem isto,
  // uma loja conectada em sandbox parece conectada de verdade — e a descoberta
  // vem pelo primeiro cliente que paga e não é cobrado.
  liveMode        Boolean?
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  // Reautorizar substitui a credencial anterior em vez de acumular lixo.
  @@unique([establishmentId, provider])
}

// Evento recebido por webhook, guardado antes de ser processado.
//
// O iFood espera 2xx em poucos segundos e reenvia o que não confirmar. Buscar o
// pedido, geocodificar e gravar leva mais que isso — então o webhook só anota, e
// o processamento acontece depois. É o padrão de fila: recebimento rápido,
// trabalho lento em separado.
//
// `externalEventId` é único porque reentrega é normal, não exceção: o mesmo
// evento chega duas vezes quando a confirmação se perde no caminho.
model IntegrationEvent {
  id              String              @id @default(uuid())
  provider        IntegrationProvider
  externalEventId String
  code            String
  externalOrderId String
  merchantId      String?
  payload         Json
  receivedAt      DateTime            @default(now())
  processedAt     DateTime?

  @@unique([provider, externalEventId])
  @@index([processedAt, receivedAt])
}

/// Caixa de saída dos avisos ao marketplace.
///
/// Quando o motoboy conclui a parada, o pedido precisa mudar de estado lá fora
/// também — senão o lojista dá baixa duas vezes, no Levô e no aplicativo. Só
/// que chamar a API de terceiro dentro da transação que grava a entrega junta
/// dois problemas: a transação fica presa esperando rede alheia, e se a chamada
/// falhar o aviso se perde sem deixar rastro.
///
/// Então a transação grava a intenção aqui, e o worker entrega depois. O aviso
/// sobrevive a queda de rede, a plataforma fora do ar e a reinício do processo.
/// O estado do pareamento do WhatsApp, espelhado do worker.
///
/// A WAHA fica presa no localhost da VM — e e assim que deve ser, porque quem
/// tem a chave dela manda mensagem pelo WhatsApp da loja. O painel roda na
/// Vercel e nao alcanca aquele endereco.
///
/// Entao o worker e a ponte: ele ja fala com os dois lados. O dono pede o QR
/// pela tela, isto grava o pedido, o worker ve, busca na WAHA e escreve a
/// imagem de volta aqui. Nenhuma porta nova aberta para a internet.
model WhatsappSession {
  establishmentId String    @id
  /// STARTING, SCAN_QR_CODE, WORKING, FAILED — como a WAHA reporta.
  status          String    @default("DESCONHECIDO")
  /// PNG do QR em base64. Vive minutos: expira e e trocado pelo proximo.
  qrBase64        String?
  qrAt            DateTime?
  /// Quando o dono pediu para parear. O worker acelera enquanto isto e recente.
  pairRequestedAt DateTime?
  /// O numero pareado, para a tela dizer qual e.
  connectedAs     String?
  updatedAt       DateTime  @updatedAt

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
}

/// Um número de WhatsApp que atende pelo Levô.
///
/// Existem três arranjos, e o que os separa é de quem é o número:
///
/// 1. **Número da loja** (`establishmentId` preenchido). A marca é dela, o
///    histórico é dela, e a conversa já chega resolvida — o número diz a loja.
/// 2. **Número do Levô, compartilhado** (`establishmentId` nulo). Onboarding em
///    minutos: o lojista não cria conta na Meta nem cadastra cartão. Em troca,
///    qual loja é a conversa precisa ser descoberta — ver `WhatsappConversation`.
/// 3. **Número do Levô, de faixa.** Igual ao 2. Vários números existem não por
///    capacidade (um aguenta 80 msg/s) mas por ISOLAMENTO: a reputação é por
///    número, então uma loja que abusa não derruba a base inteira. O teto de
///    template, esse, é do portfólio e não se divide.
///
/// A chave é o `phoneNumberId` porque é o que o webhook entrega. Guardar o
/// número em si serviria para a tela, não para resolver a conversa.
model WhatsappChannel {
  id              String   @id @default(uuid())
  /// `phone_number_id` da Cloud API — o identificador que vem em todo evento.
  phoneNumberId   String   @unique
  /// O número como se lê, só para a tela dizer qual é.
  displayNumber   String?
  /// Nulo quando o número é do Levô e atende várias lojas.
  establishmentId String?
  /// Apelido operacional: "principal", "quarentena", "volume alto".
  label           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  establishment         Establishment?         @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  whatsappConversations WhatsappConversation[]

  @@index([establishmentId])
}

/// De qual loja é a conversa deste cliente, neste número.
///
/// Só faz sentido no número compartilhado: no número da loja a resposta já veio
/// no canal. Aqui ela precisa ser lembrada, porque o cliente que volta amanhã e
/// escreve "oi" não repete o código da loja — e responder "de qual loja?" a cada
/// visita é o tipo de atrito que faz o cliente desistir e ligar.
///
/// A chave é o par canal + telefone: o mesmo cliente pode pedir de duas lojas
/// diferentes pelo mesmo número do Levô, e a última vence.
model WhatsappConversation {
  id              String   @id @default(uuid())
  channelId       String
  /// Telefone do cliente em E.164 sem o `+`, como a Meta manda.
  customerPhone   String
  establishmentId String
  /// Quando a loja foi resolvida pela última vez. Governa o desempate e a
  /// expiração: conversa velha demais pergunta de novo em vez de chutar.
  resolvedAt      DateTime @default(now())
  /// Onde a conversa parou: passo, carrinho e loja em foco.
  ///
  /// JSON e não colunas porque o formato muda a cada passo novo do fluxo, e
  /// uma migração por passo travaria a evolução. O preço é não dar para
  /// consultar por dentro — aceitável: ninguém pergunta ao banco "quantos
  /// carrinhos têm pizza". Quem lê sempre desconfia (ver `lerEstado`).
  estado          Json?

  channel       WhatsappChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  establishment Establishment   @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([channelId, customerPhone])
  @@index([establishmentId])
}

/// Caixa de saida das mensagens para o motoboy.
///
/// Mesmo padrao do aviso ao marketplace: WhatsApp fora do ar nao pode derrubar o
/// despacho da rota. O motoboy sai para entregar de qualquer jeito, e a mensagem
/// tenta de novo no ciclo seguinte do worker.
model CourierNotification {
  id              String    @id @default(uuid())
  establishmentId String
  routeId         String
  /// Por onde vai. Um canal por rota; trocar de canal e trocar de adaptador.
  channel         String    @default("WHATSAPP")
  /// Endereco no canal: telefone no WhatsApp, chat id no Telegram.
  destination     String    @default("")
  /// A tela do motoboy. Guardada a parte do texto porque no Telegram ela vira
  /// botao de Mini App, e nao um link no meio da mensagem.
  link            String?
  /// So digitos, com DDI. E o que a WAHA espera antes do @c.us.
  phone           String
  text            String
  createdAt       DateTime  @default(now())
  /// Nulo enquanto pendente; preenchido quando a WAHA aceitou.
  sentAt          DateTime?
  attempts        Int       @default(0)
  lastError       String?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  /// Uma mensagem por rota. Replanejar a mesma rota nao manda dois WhatsApp, e a
  /// unicidade torna o enfileiramento idempotente sem logica extra.
  @@unique([routeId])
  @@index([establishmentId, sentAt])
}

model MarketplaceCommand {
  id              String                 @id @default(uuid())
  establishmentId String
  provider        IntegrationProvider
  externalOrderId String
  command         MarketplaceCommandKind
  createdAt       DateTime               @default(now())
  /// Nulo enquanto pendente; preenchido quando a plataforma aceitou.
  processedAt     DateTime?
  attempts        Int                    @default(0)
  lastError       String?

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  /// Um aviso por pedido e tipo: reenviar "entregue" duas vezes não ajuda, e a
  /// unicidade torna o enfileiramento idempotente sem lógica extra.
  @@unique([provider, externalOrderId, command])
  @@index([processedAt, createdAt])
}

enum MarketplaceCommandKind {
  /// Aceito pelo lojista. No iFood vira `confirm`.
  CONFIRM
  /// Pronto para retirada pelo entregador. No aiqfome vira `mark-as-ready`.
  READY
  /// Saiu para entrega. No iFood vira `dispatch`.
  DISPATCH
  /// Entregue ao cliente. No aiqfome vira `mark-as-delivered`.
  DELIVERED
}

/// Um item que o estabelecimento vende.
///
/// O catálogo é **da plataforma**, não espelho de marketplace. Nasceu do caso
/// que nenhum aplicativo cobre: o cliente que liga ou manda mensagem no
/// WhatsApp. Sem catálogo próprio, esse pedido é digitado de cabeça e o valor
/// sai errado — e é justamente onde o dono tem mais margem.
///
/// Importar do iFood preenche a lista sem digitação, mas o produto passa a ser
/// nosso: editar aqui não escreve de volta lá. Sincronizar nos dois sentidos
/// quebraria no primeiro item que só existe no WhatsApp, que é a razão de o
/// catálogo existir.
model Product {
  id              String          @id @default(uuid())
  establishmentId String
  name            String
  description     String?
  priceCents      Int
  /// Texto livre: o lojista organiza como quiser, e importar de fora traz o
  /// nome da categoria de lá sem exigir um cadastro à parte.
  category        String?
  /// Fora de estoque, sazonal, descontinuado — sai da lista sem apagar o
  /// histórico dos pedidos que já o usaram.
  /// Endereço da foto. Guardamos a URL, não o arquivo: importar do iFood já
  /// traz a imagem hospedada lá, e o upload do lojista sobe para o Blob e
  /// grava o endereço aqui do mesmo jeito.
  imageUrl        String?
  active          Boolean         @default(true)
  /// Posição dentro da categoria. Menor primeiro; empate desempata pelo nome.
  ///
  /// O que vende mais precisa estar em cima, e isso é escolha do dono — não do
  /// alfabeto.
  position        Int             @default(0)
  /// De onde veio. `MANUAL` é cadastro próprio; o resto é procedência.
  source          OrderSourceKind @default(MANUAL)
  externalId      String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  establishment Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  optionGroups  ProductOptionGroup[]

  /// Reimportar não duplica. Em Postgres, NULL é distinto de NULL, então
  /// vários produtos manuais convivem sem esbarrar nesta restrição.
  @@unique([establishmentId, source, externalId])
  @@index([establishmentId, active, name])
}

/// Um item dentro de um pedido.
///
/// Guarda **cópia** do nome e do preço, não referência ao produto. Preço de
/// catálogo muda; o pedido registra o que foi vendido naquele dia, por aquele
/// valor. Ler o preço do produto na hora de exibir faria o histórico se
/// reescrever sozinho a cada reajuste — e a conta do dia deixaria de fechar.
///
/// `productId` fica só como procedência, e nulo quando o produto for apagado.
/// Um conjunto de escolhas que um produto oferece: tamanhos, sabores, bordas,
/// adicionais, talheres.
///
/// Vive no ESTABELECIMENTO, nao no produto, e e o que faz o cadastro caber numa
/// tarde em vez de numa semana: "Frutas" e um objeto so, usado pelos quatro
/// tamanhos de acai. Reajustar a Nutella e um numero, nao quatro.
///
/// Obrigatorio e opcional nao viram campo: saem do `minimo`. Minimo 1 e
/// obrigatorio, minimo 0 e opcional — uma regra explica "escolha ate 3 frutas",
/// "escolha 2 sabores" e "escolha a base".
///
/// Validado contra tres negocios reais de Pouso Alegre. A Pizza Prime vende o
/// TAMANHO como produto e o sabor como opcao precificada; a Skina vende o SABOR
/// como produto e o tamanho como grupo; o marmitex nao usa grupo nenhum. Os tres
/// cabem aqui sem caso especial — e o terceiro e o motivo de isto ser opcional.
model OptionGroup {
  id              String   @id @default(uuid())
  establishmentId String
  name            String
  /// Quantas escolhas o cliente PRECISA fazer. Zero torna o grupo opcional.
  min             Int      @default(0)
  /// Teto de escolhas. `2` e o meio a meio da pizza; `8` sao os cereais do acai.
  max             Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  establishment Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  options       Option[]
  products      ProductOptionGroup[]

  @@index([establishmentId, name])
}

/// Uma escolha dentro do grupo, com o quanto ela soma ao preco.
///
/// Preco zero e caso comum e nao excecao: a base do acai — acai, ninho ou misto
/// — e obrigatoria e nao cobra nada. O grupo existe para capturar a DECISAO, que
/// a cozinha precisa saber; cobrar e outro assunto.
model Option {
  id         String  @id @default(uuid())
  groupId    String
  name       String
  /// Quanto soma ao preco-base do produto. Na Pizza Prime o sabor carrega o
  /// preco inteiro e o produto vale zero; no acai o produto vale R$ 13 e o
  /// adicional soma. E a mesma conta, com a base em lugares diferentes.
  priceCents Int     @default(0)
  /// Fora de estoque some da lista sem apagar o historico dos pedidos.
  active     Boolean @default(true)
  position   Int     @default(0)

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, position])
}

/// Liga um grupo a um produto, na ordem em que aparece na tela.
model ProductOptionGroup {
  productId String
  groupId   String
  position  Int    @default(0)

  product Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  group   OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([productId, position])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  productId      String?
  /// Cópia no momento do pedido.
  name           String
  /// Complementos e customizacoes, como o marketplace os descreve.
  ///
  /// Lista separada, e nao concatenada no nome, porque a cozinha LE isto: o
  /// combo do iFood traz sete complementos, e enfiados no nome viram um
  /// paragrafo que ninguem consegue conferir enquanto monta o pedido.
  ///
  /// Sem preco proprio de proposito — `unitPriceCents` ja inclui todos eles, e
  /// repetir valor por linha faria a soma na tela discordar do total.
  options        String[]
  unitPriceCents Int
  quantity       Int
  /// Desconto ja aplicado, em centavos, sobre a linha inteira.
  ///
  /// Guardamos o valor resultante, nao a porcentagem: e o valor que entra na
  /// conta, e uma porcentagem guardada precisaria ser recalculada a cada
  /// exibicao, com chance de dar um centavo diferente.
  discountCents  Int      @default(0)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

enum PaymentMethod {
  CASH
  CREDIT
  DEBIT
  PIX
  /// Pago no aplicativo do marketplace — nao ha o que receber na porta.
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
  REFUNDED
  IN_REVIEW
  REJECTED
  CHARGED_BACK
}

model Payment {
  id              String              @id @default(uuid())
  establishmentId String
  orderId         String              @unique
  provider        IntegrationProvider
  /// Id da cobrança no gateway. Idempotência do webhook.
  externalId      String
  status          PaymentStatus       @default(PENDING)
  amountCents     Int
  qrCode          String?
  qrCodeBase64    String?
  /// Checkout Pro (cartão): página do Mercado Pago. Nulo no Pix.
  checkoutUrl     String?
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([provider, externalId])
  @@index([establishmentId, status])
}

/// Faixa de taxa de entrega por distancia.
///
/// "Ate 3 km, R$ 5. Ate 6 km, R$ 8. Acima disso, R$ 12." E como o setor
/// precifica frete, e hoje isso vive na cabeca de quem atende — que erra no
/// sabado cheio, sempre para menos.
///
/// A distancia e em LINHA RETA a partir do estabelecimento, nao pela rua. E o
/// que os aplicativos usam para faixa de frete, e a alternativa custaria uma
/// chamada de roteirizacao por pedido para mudar quase nada no valor.
model DeliveryFeeRule {
  id              String @id @default(uuid())
  establishmentId String
  /// Limite superior da faixa, em metros. A ultima faixa cobre o resto.
  uptoMeters      Int
  feeCents        Int

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, uptoMeters])
  @@index([establishmentId, uptoMeters])
}

/// O cadastro de endereços do IBGE (CNEFE), carregado por cidade.
///
/// A base do OpenStreetMap não cobre as ruas do interior; o censo do IBGE sim —
/// cada endereço com rua, bairro, número e coordenada, público e gratuito. O
/// geocodificador consulta esta tabela antes de recorrer a qualquer API externa.
model EnderecoIbge {
  id          String @id @default(uuid())
  uf          String
  /// Cidade normalizada (sem acento, minúscula) — a chave, não o nome de exibir.
  cidadeChave String
  /// Rua normalizada, sem o tipo ("rua", "av").
  ruaChave    String
  /// Bairro normalizado. Entra na chave porque desambigua ruas de mesmo nome.
  bairroChave String
  numero      Int    @default(0)
  lat         Float
  lng         Float

  @@index([uf, cidadeChave, ruaChave, bairroChave], name: "EnderecoIbge_busca_idx")
  @@index([uf, cidadeChave, ruaChave], name: "EnderecoIbge_rua_idx")
}
