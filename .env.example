# ── Banco ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://levo:levo@localhost:5432/levo?schema=public"

# ── Sessão ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-isto-por-32-bytes-aleatorios-de-verdade!!"

# ── URL pública ────────────────────────────────────────────────────────────
# Vai dentro do link de rastreio enviado ao cliente por WhatsApp.
PUBLIC_BASE_URL="http://localhost:3000"

# ── Roteirização (OSRM) ────────────────────────────────────────────────────
# Local via docker compose. O servidor público (router.project-osrm.org) só
# serve para desenvolvimento: a política de uso proíbe uso comercial
# sistemático, e um rate limit no sábado à noite custa o cliente do piloto.
OSRM_BASE_URL="http://localhost:5000"

# ── Geocodificação ─────────────────────────────────────────────────────────
# Sem chave: Nominatim público (só desenvolvimento, 1 req/s).
# Com chave: LocationIQ (https://locationiq.com) — 5.000/dia de graça.
GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"
GEOCODER_API_KEY=""
GEOCODER_USER_AGENT="levo-mvp (contato@exemplo.com.br)"

# ── Integrações (desligadas até sair a homologação) ────────────────────────
IFOOD_ENABLED="false"
IFOOD_CLIENT_ID=""
IFOOD_CLIENT_SECRET=""
IFOOD_MERCHANT_ID=""

AIQFOME_ENABLED="false"
AIQFOME_API_KEY=""
AIQFOME_MERCHANT_ID=""

# Assinatura HMAC do webhook genérico de pedidos.
WEBHOOK_SECRET=""

# ── Observabilidade ────────────────────────────────────────────────────────
LOG_LEVEL="info"
