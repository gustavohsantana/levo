# ── Banco ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://levo:levo@localhost:5432/levo?schema=public"

# ── Sessão ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-isto-por-32-bytes-aleatorios-de-verdade!!"

# ── URL pública ────────────────────────────────────────────────────────────
# Vai dentro do link de rastreio enviado ao cliente por WhatsApp.
PUBLIC_BASE_URL="http://localhost:3000"

# ── Roteirização (OSRM) ────────────────────────────────────────────────────
# Local via docker compose. O servidor público (router.project-osrm.org) só
# serve para desenvolvimento: a política de uso proíbe uso comercial
# sistemático, e um rate limit no sábado à noite custa o cliente do piloto.
OSRM_BASE_URL="http://localhost:5000"

# ── Geocodificação ─────────────────────────────────────────────────────────
# Sem chave: Nominatim público (só desenvolvimento, 1 req/s).
# Com chave: LocationIQ (https://locationiq.com) — 5.000/dia de graça.
GEOCODER_BASE_URL="https://nominatim.openstreetmap.org"
GEOCODER_API_KEY=""
GEOCODER_USER_AGENT="levo-mvp (contato@exemplo.com.br)"

# ── Integrações (desligadas até sair a homologação) ────────────────────────
# App do parceiro, um só. A *loja* é que vem da autorização do lojista
# (IntegrationCredential.merchantId), não daqui: com dois lojistas, cada um
# tem a sua loja e o clientId continua sendo o mesmo.
IFOOD_ENABLED="false"
IFOOD_CLIENT_ID=""
IFOOD_CLIENT_SECRET=""

AIQFOME_ENABLED="false"
AIQFOME_API_KEY=""
AIQFOME_MERCHANT_ID=""

# Credencial de parceiro do aiqfome, no ID Magalu.
# Emite token por client_credentials, sem consentimento de lojista — verificado
# contra o ambiente real. Uma credencial serve todas as lojas; o que separa uma
# da outra é o AIQFOME_MERCHANT_ID.
AIQFOME_CLIENT_ID=""
AIQFOME_CLIENT_SECRET=""
# Vazios = padrões do ID Magalu (autoseg-idp.luizalabs.com, publicados na
# descoberta em https://id.magalu.com/.well-known/openid-configuration).
AIQFOME_AUTH_URL=""
AIQFOME_TOKEN_URL=""
# Vazio = valem os escopos do cadastro do aplicativo. Hoje o IdP devolve
# aqf:menu:read aqf:order:create aqf:order:read aqf:store:read.
AIQFOME_SCOPE=""
# Vazio = https://merchant-api.aiqfome.com. Os caminhos dos recursos sob esse
# host ainda não foram confirmados: quando o credenciamento sair, é aqui que a
# base muda sem tocar em código.
AIQFOME_BASE_URL=""

# ── Pagamento no cardápio (Mercado Pago) ───────────────────────────────────
# O painel chama as credenciais pelos nomes abaixo — produção e teste são o
# mesmo par (Public Key + Access Token), em abas diferentes.
MERCADO_PAGO_PUBLIC_KEY=""
MERCADO_PAGO_ACCESS_TOKEN=""
MERCADO_PAGO_PUBLIC_KEY_TEST=""
MERCADO_PAGO_ACCESS_TOKEN_TEST=""
#
# OAuth de lojista, só se o painel mostrar Client ID + Client Secret.
MERCADO_PAGO_CLIENT_ID=""
MERCADO_PAGO_CLIENT_SECRET=""
# Segredo em Webhooks → Configurar notificações (não é o Client Secret).
MERCADO_PAGO_WEBHOOK_SECRET=""

# Assinatura HMAC do webhook genérico de pedidos.
WEBHOOK_SECRET=""

# ── Observabilidade ────────────────────────────────────────────────────────
LOG_LEVEL="info"
